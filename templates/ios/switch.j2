{#- Full config for a layer-2 access switch (role: switch). -#}
! Generated by scripts/render.py from data/hosts/{{ hostname | lower }}.yaml
! Do not edit by hand: change the YAML and re-render.
!
{% include "ios/_base.j2" %}
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}
{% for intf in interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
{% if intf.mode | default("") == "access" %}
 switchport mode access
 switchport access vlan {{ intf.vlan }}
{% elif intf.mode | default("") == "trunk" %}
 switchport trunk encapsulation dot1q
 switchport mode trunk
{% endif %}
{% if intf.shutdown | default(false) %}
 shutdown
{% else %}
 no shutdown
{% endif %}
!
{% endfor %}
interface Vlan{{ mgmt.vlan }}
 description MGMT SVI
 ip address {{ mgmt.ipv4 | ipv4_address }} {{ mgmt.ipv4 | ipv4_netmask }}
 no shutdown
!
ip default-gateway {{ mgmt.gateway }}
!
end
