{#- Full config for a router (role: router). -#}
! Generated by scripts/render.py from data/hosts/{{ hostname | lower }}.yaml
! Do not edit by hand: change the YAML and re-render.
!
{% include "ios/_base.j2" %}
{% for intf in interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 ip address {{ intf.ipv4 | ipv4_address }} {{ intf.ipv4 | ipv4_netmask }}
{% if intf.ospf_area is defined %}
 ip ospf {{ ospf.process_id }} area {{ intf.ospf_area }}
{% endif %}
{% if not intf.name.startswith("Loopback") %}
 no shutdown
{% endif %}
!
{% endfor %}
router ospf {{ ospf.process_id }}
 router-id {{ ospf.router_id }}
{% for intf in interfaces if intf.ospf_passive | default(false) %}
 passive-interface {{ intf.name }}
{% endfor %}
!
end
